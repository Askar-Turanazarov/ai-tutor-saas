# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow env template
!.env.example

# database
/prisma/*.db
/prisma/*.db-journal

# AI assistant / local tooling (not part of the project)
.claude/
CLAUDE.md
claude.md
AGENTS.md
agents.md
.cursorrules
/scratch/
/tests-local/
/scripts/local-*
*.log

# editors
.vscode/
.idea/

# personal to-do notes
/todo.md

# payments: dev mail and session notes
/.mail/
/done*.md
