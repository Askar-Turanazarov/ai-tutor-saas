# Database. Locally: SQLite (prisma/schema.prisma). On Vercel: Neon Postgres (prisma/postgres/schema.prisma,
# generated by npm run db:pg:schema) — DATABASE_URL is the pooled connection string, DATABASE_URL_UNPOOLED the direct one
# (migrations). For npm run db:pg:seed / db:pg:diff put both Neon strings into .env.neon instead.
DATABASE_URL="file:./dev.db"
# DATABASE_URL_UNPOOLED="postgresql://…"

# Secret for session cookies (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# AI providers — fill any of them. Without keys the built-in offline tutor (mock) is used.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Provider order for automatic fallback
AI_PROVIDER_ORDER="gemini,anthropic,openai"

# Seed accounts (created by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@ustoz.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_FREE_EMAIL="free@ustoz.local"
SEED_PLUS_EMAIL="plus@ustoz.local"
SEED_PRO_EMAIL="pro@ustoz.local"
SEED_USER_PASSWORD="demo12345"

# ───────── Payments (study / test mode) ─────────
# Public URL of the app: used in payment return links and emails.
APP_URL="http://localhost:3000"

# Stripe test keys (https://dashboard.stripe.com/test/apikeys). Without them Stripe is hidden.
# Webhook secret: `stripe listen --forward-to localhost:3000/api/payments/stripe/webhook` prints it.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Click: "emulator" = built-in test checkout (no contract needed); "live" = Click test merchant.
# Prepare/Complete URLs for the merchant cabinet: /api/payments/click/prepare and /api/payments/click/complete
CLICK_MODE="emulator"
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_MERCHANT_USER_ID=""
CLICK_SECRET_KEY=""

# Fiscal receipts: mock-ofd (test receipts) | click-ofd (Click registers them with the OFD, live mode) | none
FISCAL_PROVIDER="mock-ofd"

# Email. Every email is logged to the outbox (Admin → Outbox); without SMTP_URL nothing is sent (emulation)
SMTP_URL=""
MAIL_FROM="Ustoz AI <no-reply@ustoz.local>"

# On Vercel the timer is off; vercel.json runs the job daily at 05:00 UTC through Vercel Cron, which sends CRON_SECRET.
# Billing job: runs every 5 min inside the server (BILLING_TIMER=off disables it);
# an external cron can call GET /api/cron/billing with "Authorization: Bearer $CRON_SECRET"
BILLING_TIMER="on"
CRON_SECRET=""

# Telegram bot (@BotFather). Without TELEGRAM_BOT_TOKEN the bot is emulated in the app (Settings → Telegram).
# Locally: npm run tg:poll forwards updates; after deploy: npm run tg:setup sets the webhook and the Mini App button.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Any random string; Telegram sends it back in the X-Telegram-Bot-Api-Secret-Token header
TELEGRAM_WEBHOOK_SECRET=""
