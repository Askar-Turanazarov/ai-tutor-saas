# SQLite database
DATABASE_URL="file:./dev.db"

# Secret for session cookies (any long random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# AI providers — fill any of them. Without keys the built-in offline tutor (mock) is used.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Provider order for automatic fallback
AI_PROVIDER_ORDER="gemini,anthropic,openai"

# Seed accounts (created by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@ustoz.local"
SEED_ADMIN_PASSWORD="admin12345"
SEED_FREE_EMAIL="free@ustoz.local"
SEED_PLUS_EMAIL="plus@ustoz.local"
SEED_PRO_EMAIL="pro@ustoz.local"
SEED_USER_PASSWORD="demo12345"

# Payments
# Shared secret for POST /api/billing/renew (external cron for automatic renewals)
CRON_SECRET=""

# Click SHOP API. Without CLICK_MODE=live the built-in emulator is used.
CLICK_MODE="mock"
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# Stripe (test mode). Without a key the Stripe option is hidden.
# Webhook locally: stripe listen --forward-to localhost:3000/api/billing/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
