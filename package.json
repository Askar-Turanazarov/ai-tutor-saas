{
  "name": "ai-tutor-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "setup": "prisma db push && tsx --env-file=.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/pg-schema.mjs && prisma generate --schema prisma/postgres/schema.prisma && prisma migrate deploy --schema prisma/postgres/schema.prisma && next build --turbopack",
    "db:pg:schema": "node scripts/pg-schema.mjs",
    "db:pg:diff": "node scripts/pg-diff.mjs",
    "db:pg:seed": "node scripts/pg-seed.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tg:poll": "node scripts/tg-poll.mjs",
    "tg:setup": "node scripts/tg-setup.mjs"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@prisma/client": "^6.19.3",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.5.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "next": "15.5.27",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.15",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.1.0",
    "stripe": "^23.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  }
