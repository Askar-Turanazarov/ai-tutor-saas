generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  passwordHash     String
  role             String          @default("USER") // USER | ADMIN
  plan             String          @default("FREE") // FREE | PLUS | PRO — cache of the active subscription
  level            String          @default("A1") // A1..C2
  goal             String?
  locale           String          @default("ru")
  onboarded        Boolean         @default(false)
  xp               Int             @default(0)
  streak           Int             @default(0)
  lastActiveDate   String?
  trialUsedAt      DateTime?
  stripeCustomerId String?
  createdAt        DateTime        @default(now())
  conversations    Conversation[]
  usages           DailyUsage[]
  mistakes         Mistake[]
  units            PlanUnit[]
  quizzes          Quiz[]
  attempts         QuizAttempt[]
  subscription     Subscription?
  invoices         Invoice[]
  paymentMethods   PaymentMethod[]
  dailyCounters    DailyCounter[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicSlug String?
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  corrections    String? // JSON
  tips           String? // JSON (pronunciation tips)
  provider       String?
  model          String?
  createdAt      DateTime     @default(now())
}

model Topic {
  id      String  @id @default(cuid())
  slug    String  @unique
  level   String
  icon    String
  proOnly Boolean @default(false)
  order   Int     @default(0)
  titleRu String
  titleEn String
  titleUz String
  descRu  String
  descEn  String
  descUz  String
  starter String // first tutor line, English
}

model Mistake {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  original    String
  corrected   String
  explanation String
  createdAt   DateTime @default(now())
}

model PlanUnit {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Int
  topicSlug String
  level     String
  status    String @default("locked") // locked | current | done
  stars     Int    @default(0)
  quizzes   Quiz[]
}

model Quiz {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      PlanUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title     String
  level     String
  questions String // JSON
  source    String // provider id
  createdAt DateTime      @default(now())
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  xp        Int
  createdAt DateTime @default(now())
}

model DailyUsage {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD in Asia/Tashkent
  seconds Int    @default(0)

  @@unique([userId, date])
}

/// Per-day quota counters (lessons, missions, pronunciation…), day in Asia/Tashkent.
model DailyCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  key    String
  count  Int    @default(0)

  @@unique([userId, date, key])
}

model AILog {
  id        String   @id @default(cuid())
  task      String
  provider  String
  model     String
  ok        Boolean
  latencyMs Int
  attempt   Int
  error     String?
  userId    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// One current subscription per user; history lives in Invoice.
model Subscription {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               String // PLUS | PRO
  period             Int // months: 1 | 3 | 12
  status             String // trialing | active | past_due | canceled | expired
  provider           String // card | click | stripe | trial | admin
  providerRef        String? // e.g. Stripe subscription id
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean        @default(false)
  graceUntil         DateTime?
  pendingTier        String? // downgrade scheduled for the next period
  pendingPeriod      Int?
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoices           Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tier           String
  period         Int
  amount         Int // whole UZS, or cents for USD
  currency       String // UZS | USD
  provider       String
  kind           String        @default("new") // new | renewal | upgrade
  status         String        @default("pending") // pending | paid | failed | canceled | refunded
  saveCard       Boolean       @default(false)
  providerTxId   String?
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// A tokenized card. Only the token and display data are stored, never the card number.
model PaymentMethod {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  brand         String // uzcard | humo | visa | mastercard
  last4         String
  expMonth      Int
  expYear       Int
  token         String
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

/// Click SHOP API transaction. The numeric id is our merchant_prepare_id / merchant_confirm_id.
model ClickTransaction {
  id           Int      @id @default(autoincrement())
  clickTransId String   @unique
  invoiceId    String
  amount       Int
  status       String   @default("prepared") // prepared | completed | cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
