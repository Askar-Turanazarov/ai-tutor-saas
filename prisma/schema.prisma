generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String
  role             String           @default("USER") // USER | ADMIN
  plan             String           @default("FREE") // FREE | PLUS | PRO — cache of the active subscription
  level            String           @default("A1") // A1..C2
  goal             String?
  locale           String           @default("ru")
  onboarded        Boolean          @default(false)
  xp               Int              @default(0)
  streak           Int              @default(0)
  lastActiveDate   String?
  bestStreak       Int              @default(0)
  /// Daily XP goal: 30 | 60 | 120
  dailyGoal        Int              @default(60)
  /// Streak freezes in stock; refilled monthly from the plan
  streakFreezes    Int              @default(0)
  freezeMonth      String? // YYYY-MM of the last refill
  /// Profile level the learner has already seen celebrated
  levelSeen        Int              @default(1)
  /// Weekly league: 0 bronze … 4 turquoise; leagueWeek = Monday of the week it was last settled
  league           Int              @default(0)
  leagueWeek       String?
  /// JSON {from,to,rank} of the last settled week, shown once on the league page
  leagueLast       String?
  trialUsedAt      DateTime?
  stripeCustomerId String?
  createdAt        DateTime         @default(now())
  conversations    Conversation[]
  usages           DailyUsage[]
  mistakes         Mistake[]
  units            PlanUnit[]
  quizzes          Quiz[]
  attempts         QuizAttempt[]
  subscription     Subscription?
  invoices         Invoice[]
  paymentMethods   PaymentMethod[]
  dailyCounters    DailyCounter[]
  lessonProgress   LessonProgress[]
  reviewCards      ReviewCard[]
  skills           Skill[]
  lessons          Lesson[]
  xpEvents         XpEvent[]
  achievements     UserAchievement[]
  quests           DailyQuest[]
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicSlug String?
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  corrections    String? // JSON
  tips           String? // JSON (pronunciation tips)
  provider       String?
  model          String?
  createdAt      DateTime     @default(now())
}

model Topic {
  id      String  @id @default(cuid())
  slug    String  @unique
  level   String
  icon    String
  proOnly Boolean @default(false)
  order   Int     @default(0)
  titleRu String
  titleEn String
  titleUz String
  descRu  String
  descEn  String
  descUz  String
  starter String // first tutor line, English
}

model Mistake {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  original    String
  corrected   String
  explanation String
  source      String    @default("chat") // chat | exercise | review
  itemId      String?
  hits        Int       @default(1)
  /// Correct answers in a row while training; 3 resolves the mistake.
  streak      Int       @default(0)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([userId, resolvedAt])
}

model PlanUnit {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Int
  topicSlug String
  level     String
  status    String @default("locked") // locked | current | done
  stars     Int    @default(0)
  quizzes   Quiz[]
}

model Quiz {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  unit      PlanUnit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  title     String
  level     String
  questions String // JSON
  source    String // provider id
  createdAt DateTime      @default(now())
  attempts  QuizAttempt[]
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  xp        Int
  createdAt DateTime @default(now())
}

model DailyUsage {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    String // YYYY-MM-DD in Asia/Tashkent
  seconds Int    @default(0)

  @@unique([userId, date])
}

/// Per-day quota counters (lessons, missions, pronunciation…), day in Asia/Tashkent.
model DailyCounter {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   String
  key    String
  count  Int    @default(0)

  @@unique([userId, date, key])
}

model AILog {
  id        String   @id @default(cuid())
  task      String
  provider  String
  model     String
  ok        Boolean
  latencyMs Int
  attempt   Int
  error     String?
  userId    String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

/// One current subscription per user; history lives in Invoice.
model Subscription {
  id                 String         @id @default(cuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier               String // PLUS | PRO
  period             Int // months: 1 | 3 | 12
  status             String // trialing | active | past_due | canceled | expired
  provider           String // card | click | stripe | trial | admin
  providerRef        String? // e.g. Stripe subscription id
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean        @default(false)
  graceUntil         DateTime?
  pendingTier        String? // downgrade scheduled for the next period
  pendingPeriod      Int?
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  invoices           Invoice[]
}

model Invoice {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  tier           String
  period         Int
  amount         Int // whole UZS, or cents for USD
  currency       String // UZS | USD
  provider       String
  kind           String        @default("new") // new | renewal | upgrade
  status         String        @default("pending") // pending | paid | failed | canceled | refunded
  saveCard       Boolean       @default(false)
  providerTxId   String?
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// A tokenized card. Only the token and display data are stored, never the card number.
model PaymentMethod {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      String
  brand         String // uzcard | humo | visa | mastercard
  last4         String
  expMonth      Int
  expYear       Int
  token         String
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

/// Click SHOP API transaction. The numeric id is our merchant_prepare_id / merchant_confirm_id.
model ClickTransaction {
  id           Int      @id @default(autoincrement())
  clickTransId String   @unique
  invoiceId    String
  amount       Int
  status       String   @default("prepared") // prepared | completed | cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A lexical chunk: the unit of vocabulary (collocation, phrasal verb, idiom, fixed phrase).
model LexicalItem {
  id           String       @id // stable content key, e.g. "a1.chaikhana.a-pot-of-tea"
  chunk        String
  kind         String // collocation | phrasal | idiom | fixed | word
  level        String
  difficulty   Int // Elo scale, ~400 (A1) … 900 (C2)
  meaningRu    String
  meaningEn    String
  meaningUz    String
  examples     String // JSON string[]
  antiExamples String       @default("[]") // JSON [{ wrong, right, why: {ru,en,uz} }]
  register     String       @default("neutral") // neutral | informal | formal
  tags         String       @default("") // comma-separated situation tags
  reviewCards  ReviewCard[]
}

/// A lesson built around a real-life task. Exercises and the mission are JSON (see src/lib/content/types.ts).
model Lesson {
  id         String           @id @default(cuid())
  slug       String           @unique
  level      String
  order      Int              @default(0)
  difficulty Int
  icon       String
  titleRu    String
  titleEn    String
  titleUz    String
  situation  String // JSON {ru,en,uz}
  canDo      String // JSON {ru,en,uz}
  itemIds    String // JSON string[]
  exercises  String // JSON Exercise[]
  mission    String // JSON Mission
  minTier    String           @default("FREE")
  source     String           @default("bank") // bank | ai
  /// Personal AI lessons belong to one user; bank lessons are shared.
  ownerId    String?
  owner      User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  progress   LessonProgress[]

  @@index([level, order])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String    @default("started") // started | done
  stars       Int       @default(0)
  bestScore   Int       @default(0) // percent
  missionDone Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
}

/// Spaced-repetition state of one chunk for one learner (simplified SM-2).
model ReviewCard {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId       String
  item         LexicalItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  due          DateTime
  intervalDays Float       @default(0)
  ease         Float       @default(2.3)
  reps         Int         @default(0)
  lapses       Int         @default(0)
  avgMs        Int         @default(0)
  lastGrade    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, itemId])
  @@index([userId, due])
}

/// Elo-style ability per skill area.
model Skill {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   String // vocab | grammar | listening | speaking
  rating Int

  @@unique([userId, area])
}

/* ───────────── Gamification ───────────── */

/// Every XP award: the daily goal, quests and the weekly league are sums over these.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    String // lesson | review | mistakes | chat | quiz | pronunciation | mission | quest | achievement
  date      String // YYYY-MM-DD, Tashkent
  createdAt DateTime @default(now())

  @@index([userId, date])
  @@index([date])
}

/// Definitions live in code (src/lib/gamification/achievements.ts) and are synced here.
model Achievement {
  id        String            @id // key, e.g. "streak-7"
  icon      String
  metric    String
  threshold Int
  xp        Int
  order     Int
  users     UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())
  seen          Boolean     @default(false)

  @@unique([userId, achievementId])
}

model DailyQuest {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD, Tashkent
  key      String // xp | lesson | correct | review | chat | mission | perfect
  target   Int
  progress Int       @default(0)
  xp       Int
  doneAt   DateTime?

  @@unique([userId, date, key])
}

/// Demo players fill the weekly league so it never looks empty; their XP is computed, not stored.
model DemoPlayer {
  id     String @id @default(cuid())
  name   String
  league Int
  /// Average XP per day
  pace   Int
}
